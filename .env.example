# Copy to .env and adjust. Never commit .env.

# Elasticsearch URL reachable from the backend.
ES_URL=http://localhost:9200

# HMAC secret used to sign session JWTs. Must be long, random, and kept secret.
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# How long a practice session lasts, in minutes.
SESSION_TTL_MIN=60

# SQLite database path (relative to backend working dir, or absolute).
DATABASE_URL=sqlite://data.db?mode=rwc

# Bind address for the Axum server.
BIND_ADDR=0.0.0.0:8080

# Upload caps.
MAX_UPLOAD_BYTES=52428800       # 50 MiB
MAX_DOCS_PER_INDEX=100000

# Allowed origin for the frontend (CORS). In dev this is the Vite server.
FRONTEND_ORIGIN=http://localhost:5173
